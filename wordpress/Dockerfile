# AppShelf WordPress image: WordPress Multisite (subdirectory) with wp-cli,
# the three template themes and the network mu-plugins baked in.
# wp-init copies themes and mu-plugins from /opt/appshelf into the wp_data volume.

FROM wordpress:cli-2.12.0-php8.3 AS wpcli

FROM wordpress:7.1.4-php8.3-apache

COPY --from=wpcli /usr/local/bin/wp /usr/local/bin/wp

COPY config/apache-appshelf.conf /etc/apache2/conf-available/appshelf.conf
COPY config/php-appshelf.ini /usr/local/etc/php/conf.d/zz-appshelf.ini
RUN a2enconf appshelf && a2enmod headers expires deflate

# Same path the worker image uses for the site scripts (docs/contracts.md).
COPY scripts/ /opt/appshelf/wp/
COPY bin/ /opt/appshelf/bin/
COPY config/htaccess-multisite /opt/appshelf/htaccess-multisite
COPY mu-plugins/ /opt/appshelf/mu-plugins/
COPY templates/ /opt/appshelf/templates/
RUN chmod 0755 /opt/appshelf/wp/*.sh /opt/appshelf/bin/*.sh

# wp-config.php (generated by the official entrypoint) evals this at runtime.
ENV WORDPRESS_CONFIG_EXTRA="require '/opt/appshelf/wp/wp-config-extra.php';" \
    WP_DOMAIN=wp.appshelf.localhost \
    WP_SCHEME=http

ENTRYPOINT ["/opt/appshelf/bin/entrypoint.sh"]
CMD ["apache2-foreground"]
