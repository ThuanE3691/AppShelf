{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1240px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "Paper", "color": "#f5f4f0" },
				{ "slug": "surface", "name": "Stone", "color": "#e8e5dc" },
				{ "slug": "contrast", "name": "Ink", "color": "#111111" },
				{ "slug": "muted", "name": "Graphite", "color": "#56534c" },
				{ "slug": "accent", "name": "Indigo", "color": "#3b2dd6" },
				{ "slug": "accent-2", "name": "Coral", "color": "#ff6b4a" },
				{ "slug": "accent-3", "name": "Lilac", "color": "#b9b3ff" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Sans",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "ui-monospace, \"SF Mono\", \"Cascadia Mono\", \"Segoe UI Mono\", Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.375rem", "fluid": { "min": "1.1875rem", "max": "1.5rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "2.75rem", "fluid": { "min": "1.875rem", "max": "3.25rem" } },
				{ "slug": "xx-large", "name": "Display", "size": "4.5rem", "fluid": { "min": "2.625rem", "max": "5.75rem" } }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "em", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "clamp(1.25rem, 4vw, 2rem)" },
				{ "slug": "50", "name": "L", "size": "clamp(2.25rem, 6vw, 4rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(3.5rem, 10vw, 7.5rem)" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "var(--wp--preset--spacing--40)",
				"right": "var(--wp--preset--spacing--40)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontWeight": "800",
					"lineHeight": "1.08",
					"letterSpacing": "-0.03em"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "lineHeight": "0.98", "letterSpacing": "-0.045em" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "lineHeight": "1.02", "letterSpacing": "-0.035em" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "lineHeight": "1.2", "letterSpacing": "-0.015em" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--accent)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "typography": { "textDecoration": "none" } }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#ffffff"
				},
				"border": { "radius": "0" },
				"spacing": { "padding": { "top": "0.875rem", "bottom": "0.875rem", "left": "1.5rem", "right": "1.5rem" } },
				"typography": { "fontSize": "1rem", "fontWeight": "700", "lineHeight": "1.25", "textDecoration": "none" },
				":hover": { "color": { "background": "var(--wp--preset--color--contrast)", "text": "#ffffff" } }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": { "fontSize": "1.25rem", "fontWeight": "800", "letterSpacing": "-0.03em" },
				"elements": { "link": { "color": { "text": "var(--wp--preset--color--contrast)" }, "typography": { "textDecoration": "none" } } }
			},
			"core/navigation": {
				"typography": { "fontSize": "0.9375rem", "fontWeight": "600" },
				"elements": { "link": { "color": { "text": "var(--wp--preset--color--contrast)" }, "typography": { "textDecoration": "none" } } }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
