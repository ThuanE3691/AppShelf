{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1180px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "Cream", "color": "#faf6f0" },
				{ "slug": "surface", "name": "Sand", "color": "#f1e7d8" },
				{ "slug": "contrast", "name": "Ink", "color": "#1f1a17" },
				{ "slug": "muted", "name": "Smoke", "color": "#5c524a" },
				{ "slug": "accent", "name": "Ember", "color": "#a63f1b" },
				{ "slug": "accent-2", "name": "Olive", "color": "#3d4a2f" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "serif",
					"name": "Serif",
					"fontFamily": "\"Iowan Old Style\", \"Palatino Linotype\", Palatino, \"Book Antiqua\", Georgia, serif"
				},
				{
					"slug": "sans",
					"name": "Sans",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.9375rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.375rem", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "2.25rem", "fluid": { "min": "1.75rem", "max": "2.5rem" } },
				{ "slug": "xx-large", "name": "Huge", "size": "3.5rem", "fluid": { "min": "2.4rem", "max": "4rem" } }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "em", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "clamp(1.25rem, 4vw, 2rem)" },
				{ "slug": "50", "name": "L", "size": "clamp(2rem, 6vw, 3.5rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(3rem, 9vw, 6rem)" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "var(--wp--preset--spacing--40)",
				"right": "var(--wp--preset--spacing--40)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontWeight": "600",
					"lineHeight": "1.15"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "letterSpacing": "-0.01em" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--accent)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "typography": { "textDecoration": "none" } }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#ffffff"
				},
				"border": { "radius": "999px" },
				"spacing": { "padding": { "top": "0.8rem", "bottom": "0.8rem", "left": "1.6rem", "right": "1.6rem" } },
				"typography": { "fontSize": "1rem", "fontWeight": "600", "textDecoration": "none" },
				":hover": { "color": { "background": "var(--wp--preset--color--contrast)", "text": "#ffffff" } },
				":focus": { "outline": { "color": "var(--wp--preset--color--contrast)", "offset": "3px", "style": "solid", "width": "2px" } }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--serif)", "fontSize": "1.5rem", "fontWeight": "700" },
				"elements": { "link": { "color": { "text": "var(--wp--preset--color--contrast)" }, "typography": { "textDecoration": "none" } } }
			},
			"core/navigation": {
				"typography": { "fontSize": "0.9375rem", "fontWeight": "500" },
				"elements": { "link": { "color": { "text": "var(--wp--preset--color--contrast)" }, "typography": { "textDecoration": "none" } } }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
